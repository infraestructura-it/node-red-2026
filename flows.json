    {
        "id": "fn-disco",
        "type": "function",
        "z": "tab-iit-exec-demo",
        "name": "parsear JSON",
        "func": "if (msg.exitCode === 0 && msg.payload) {\n    try {\n        msg.payload = JSON.parse(msg.payload);\n        msg.payload.UsedGB = (msg.payload.Used / 1e9).toFixed(2);\n        msg.payload.FreeGB = (msg.payload.Free / 1e9).toFixed(2);\n    } catch (e) {\n        node.warn(\"No se pudo parsear el JSON: \" + e.message);\n    }\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 180,
        "wires": [
            [
                "dbg-disco"
            ]
        ]
    },
