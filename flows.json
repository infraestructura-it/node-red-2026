    {
        "id": "fn-impresoras",
        "type": "function",
        "z": "tab-iit-exec-demo",
        "name": "detectar fallas",
        "func": "if (msg.exitCode !== 0) {\n    node.status({fill:\"red\", shape:\"ring\", text:\"error exec\"});\n    return msg;\n}\n\nlet printers = [];\ntry {\n    const parsed = JSON.parse(msg.payload);\n    printers = Array.isArray(parsed) ? parsed : [parsed];\n} catch (e) {\n    node.warn(\"No se pudo parsear: \" + e.message);\n    return msg;\n}\n\nconst conFallas = printers.filter(p => p.PrinterStatus !== 0 && p.PrinterStatus !== \"Normal\");\n\nmsg.payload = {\n    total: printers.length,\n    conFallas: conFallas.length,\n    detalle: printers\n};\n\nif (conFallas.length > 0) {\n    node.status({fill:\"yellow\", shape:\"dot\", text:conFallas.length + \" con falla\"});\n} else {\n    node.status({fill:\"green\", shape:\"dot\", text:\"todo normal\"});\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 680,
        "y": 260,
        "wires": [
            [
                "dbg-impresoras"
            ]
        ]
    },
